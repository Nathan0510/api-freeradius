{
    "swagger": "2.0",
    "info": {
        "description": "API Freeradius pour la gestion des utilisateurs et des NAS",
        "title": "Radius API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/nas": {
            "get": {
                "description": "Récupère la liste complète de tous les NAS configurés",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NAS"
                ],
                "summary": "Récupérer tous les NAS Radius",
                "responses": {
                    "200": {
                        "description": "Liste des NAS récupérée avec succès",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Nas"
                            }
                        }
                    },
                    "500": {
                        "description": "Erreur serveur interne",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/nas/{username}": {
            "get": {
                "description": "Afficher la configuration d'un NAS",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NAS"
                ],
                "summary": "Afficher un NAS",
                "responses": {
                    "200": {
                        "description": "NAS récupérée avec succès",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Nas"
                            }
                        }
                    },
                    "500": {
                        "description": "Erreur serveur interne",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "delete": {
                "description": "Supprime un NAS existant à partir du nom d'utilisateur fourni",
                "tags": [
                    "NAS"
                ],
                "summary": "Supprime un NAS",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Nom d'utilisateur du NAS",
                        "name": "username",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Message de succès\"  example(map[string]string{\"message\":\"Nas deleted successfully\"})",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Message d'erreur",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Nas": {
            "type": "object",
            "properties": {
                "community": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "nasname": {
                    "type": "string"
                },
                "ports": {
                    "type": "integer"
                },
                "secret": {
                    "type": "string"
                },
                "server": {
                    "type": "string"
                },
                "shortname": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        }
    }
}