                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NAS"
                ],
                "summary": "Get all NAS",
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "500": {
                        "description": "Error"
                    }
                }
            },
            "post": {
                "description": "Add NAS",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NAS"
                ],
                "summary": "Add NAS",
                "parameters": [
                    {
                        "description": "New NAS data",
                        "name": "nas",
